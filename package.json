{
  "name": "suhtleja",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "db:clone:remote-to-local": "bash ./scripts/db/clone-d1-remote-to-local.sh",
    "deploy": "pnpm run deploy:app:full",
    "deploy:app": "opennextjs-cloudflare build && rm -rf .open-next/cache/__fetch && opennextjs-cloudflare deploy --rclone --cacheChunkSize 10",
    "deploy:app:full": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --rclone --cacheChunkSize 10",
    "deploy:database": "pnpm run migrate:remote",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "dev:suhtleja": "cross-env NODE_OPTIONS=--no-deprecation NEXT_PUBLIC_SERVER_URL=http://suhtleja.test:3000 next dev --webpack -H suhtleja.test -p 3000",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "migrate": "pnpm payload migrate",
    "migrate:create": "pnpm payload migrate:create",
    "migrate:remote": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate",
    "migrate:status:remote": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate:status",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "wrangler:login": "pnpm exec wrangler login"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faceless-ui/modal": "3.0.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@payloadcms/admin-bar": "3.92.0",
    "@payloadcms/db-d1-sqlite": "3.92.0",
    "@payloadcms/live-preview-react": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-form-builder": "3.92.0",
    "@payloadcms/plugin-nested-docs": "3.92.0",
    "@payloadcms/plugin-redirects": "3.92.0",
    "@payloadcms/plugin-search": "3.92.0",
    "@payloadcms/plugin-seo": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-r2": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "^1.8.2",
    "graphql": "^16.8.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.553.0",
    "next": "16.4.3",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "payload": "3.92.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "^1.5.2",
    "react-hook-form": "7.91.0",
    "react-resizable": "3.1.3",
    "sonner": "^2.0.8",
    "stripe": "^20.3.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.3",
    "@types/escape-html": "^1.0.2",
    "@types/node": "^22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.6.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "28.0.0",
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "rclone.js": "0.6.6",
    "tailwindcss": "^3.4.3",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5",
    "wrangler": "~4.152.0"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "rclone.js",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
