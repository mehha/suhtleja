{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "suhtleja",
  "account_id": "5e14935f8ec5af079f9a4b1090f57456",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image asks Cloudflare Images for each picture size through /cdn-cgi/image
  // (src/utilities/imageLoader.ts). Pictures may come only from these hosts: the site, the media
  // domain and the symbol banks whose pictures aren't SVG (ARASAAC; Global Symbols, in case it serves
  // a PNG). Add a host here before cards show pictures from it. `wrangler deploy` (4.168+) applies this.
  "images": {
    "url_transformations": {
      "enabled": true,
      "allowed_origins": ["suhtleja.ee", "media.suhtleja.ee", "static.arasaac.org", "globalsymbols.com"]
    }
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "b034d8a8-f854-4dbf-8a76-68206fa284f9",
      "database_name": "suhtleja",
      "remote": true
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "b034d8a8-f854-4dbf-8a76-68206fa284f9",
      "database_name": "suhtleja",
      "remote": true
    }
  ],
  "ai": {
    // Workers AI for the board editor's "Loo pilt" (/next/symbol-generate). Always remote, also in local dev.
    "binding": "AI",
    "remote": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "suhtleja"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "suhtleja",
      "preview_bucket_name": "suhtleja",
      "remote": true
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "suhtleja",
      "preview_bucket_name": "suhtleja"
    }
  ],
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "NEXT_PUBLIC_SERVER_URL": "https://suhtleja.ee",
    "NEXT_INC_CACHE_R2_PREFIX": "opennext-cache",
    "SPEECH_REGION": "northeurope",
    "SPEECH_VOICE": "et-EE-AnuNeural"
  }
}
