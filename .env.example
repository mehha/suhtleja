# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://suhtleja.test:3000

# Public base URL for R2-served media. Defaults to https://media.suhtleja.ee when unset
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.suhtleja.ee

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Parent PIN assigned to newly created users (4 digits). Falls back to 0000 when unset
DEFAULT_PARENT_PIN=0000

# Groq (grammar surface forms and symbol search terms)
GROQ_API_KEY=YOUR_SECRET_HERE
# Optional, defaults to qwen/qwen3-32b
GROQ_MODEL=qwen/qwen3-32b

# Azure Speech (/next/tts-ms)
SPEECH_KEY=YOUR_SECRET_HERE
SPEECH_REGION=YOUR_REGION_HERE
SPEECH_VOICE=YOUR_VOICE_HERE
# Optional, defaults to audio-24khz-48kbitrate-mono-mp3
SPEECH_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3

# Comma-separated emails that skip the membership gate (owner/test accounts). Empty = nobody
MEMBERSHIP_BYPASS_EMAILS=

# Stripe membership
STRIPE_SECRET_KEY=YOUR_SECRET_HERE
STRIPE_WEBHOOK_SECRET=YOUR_SECRET_HERE
STRIPE_PRICE_ID_MEMBERSHIP=price_XXXXXXXXXXXX
# Optional: specific billing portal configuration ID (otherwise Stripe default is used)
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_XXXXXXXXXXXX

# Deploy only (GitHub Actions secret / local `pnpm wrangler:login` alternative)
# CLOUDFLARE_API_TOKEN=YOUR_TOKEN_HERE
